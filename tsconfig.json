{
  "extends": "./tsconfig.flags.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2024"
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts"
  ]
}
