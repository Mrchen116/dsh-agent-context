{
  "name": "dsh-agent-context",
  "description": "Session-scoped notes, archived history and deterministic context windows for DSH.",
  "version": "0.3.0-rc.2",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mrchen116/dsh-agent-context.git"
  },
  "homepage": "https://github.com/Mrchen116/dsh-agent-context#readme",
  "bugs": {
    "url": "https://github.com/Mrchen116/dsh-agent-context/issues"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "rm -rf lib && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-commands": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-compaction": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-home-paths": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-token-meter": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.1",
    "@deepseek-ai/schemastery": "~3.18.5-alpha.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-commands": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-compaction": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-home-paths": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-token-meter": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.1",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1",
    "@deepseek-ai/dsh-agent-loop": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-agent-loop-testkit": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session-projection": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-scope": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-attachment": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-compaction-image-offload": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-llm-retry": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-ptc-runtime": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-sandbox": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-user-approval": "0.2.1-alpha.1"
  },
  "engines": {
    "node": ">=22.19"
  },
  "keywords": [
    "deepseek-harness",
